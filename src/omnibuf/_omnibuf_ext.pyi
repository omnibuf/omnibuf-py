        pbpy_mode: bool = False,
    ) -> None: ...
    def set_fields(self, specs: list[dict[str, Any]], field0_wire: bytes) -> None: ...
    def field0_bytes(self) -> bytes: ...
    def encode_single_field(
        self,
        fnum: int,
        val: Any,
        *,
        deterministic: bool = False,
    ) -> bytes: ...
    def marshal(
        self,
        msg: Any,
        *,
        deterministic: bool = False,
        self_describing: bool = False,
    ) -> bytes: ...
    def unmarshal(
        self,
        data: Buffer,
        out: T | None = None,
        *,
        max_elements: int | None = None,
        zero_copy_bytes: bool = False,
    ) -> T: ...
    def decode_at(
        self,
        data: Buffer,
        out: T | None = None,
        depth: int = 0,
        merge: bool = False,
        *,
        max_elements: int | None = None,
        zero_copy_bytes: bool = False,
    ) -> T: ...

